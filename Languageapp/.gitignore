/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Build output
target/

# IDE files
*.class
*.jar
.idea/
*.iml

# OS files
Thumbs.db
Desktop.ini
This PC - Shortcut.lnk
*.lnk
